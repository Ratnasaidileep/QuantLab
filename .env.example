# QuantLab Environment Variables Template
# Copy this file to .env for local customized configurations

QUANTLAB_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
QUANTLAB_DATA_DIR=data
QUANTLAB_DB_PATH=data/quantlab.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Production Port (for docker-compose)
FRONTEND_PORT=3000

# Streamlit Interface Port (for optional container)
STREAMLIT_PORT=8501
